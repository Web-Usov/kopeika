# Token from @BotFather (/newbot). Keep it secret: never commit the real .env.
BOT_TOKEN=

# Public HTTPS address of the Mini App (the URL set in @BotFather → /newapp).
APP_URL=https://kopeika.usov-home.ru

# Short name of the Mini App from @BotFather (/newapp): the "app" part in t.me/<bot>/app.
# Used to build invite links t.me/<bot>/<short>?startapp=<code>.
APP_SHORT_NAME=

# If api.telegram.org is blocked or slow from your server: address of a proxy or a self-hosted
# Bot API server (default https://api.telegram.org). The server starts either way; the bot keeps retrying.
# TELEGRAM_API_ROOT=http://bot-api-proxy:8081
# Timeout of Telegram requests in seconds (default 20).
# TELEGRAM_TIMEOUT_SEC=20

# Local development only. Set BOT_POLLING=0 if the production bot already polls with the same token,
# otherwise both instances fight over updates. DEV_AUTH=1 lets a plain browser act as a fake user
# (?dev=1, ?dev=2 …). NEVER set DEV_AUTH in production.
# BOT_POLLING=0
# DEV_AUTH=1

# Daily SQLite backups (VACUUM INTO). Defaults: <folder of DB_PATH>/backups (/data/backups in Docker), keep 14.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14

# Max API requests per user per minute (default 120).
# RATE_LIMIT_PER_MIN=120

# Max exchange-rate requests (GET /api/rates) per user per minute, on top of the general limit (default 20).
# RATES_LIMIT_PER_MIN=20

# Telegram ids (comma-separated) allowed to send /stats to the bot in a private chat. Empty = nobody.
# ADMIN_USER_IDS=123456789

# Tell ADMIN_USER_IDS in a private message about server errors (5xx, crashes) and errors reported by the app:
# the first one at once, repeats at most once an hour, at most 20 messages an hour. 0 = log only.
# ERROR_ALERTS=1

# Hour (0-23, server local time) when the bot posts the daily digest to chats in "daily" mode (default 20).
# CHAT_DIGEST_HOUR=20

# Receipt scanning (photo -> items). Empty key = the feature is off (the app hides it, the API answers 503).
# The key is secret: never commit it. Anthropic must be reachable from the server.
# ANTHROPIC_API_KEY=
# Who reads receipts: anthropic (default) or openrouter (any OpenAI-compatible API: OpenRouter, your own vLLM).
# RECEIPTS_PROVIDER=anthropic
# Key of the openrouter provider; empty = the feature is off when RECEIPTS_PROVIDER=openrouter.
# OPENROUTER_API_KEY=
# Base URL of the OpenAI-compatible API (default https://openrouter.ai/api/v1); set it for your own server.
# OPENROUTER_BASE_URL=
# Optional: comma-separated OpenRouter provider slugs allowed to serve requests (provider.only).
# OPENROUTER_PROVIDERS=
# Optional gateway/proxy for outgoing traffic to the Anthropic API.
# ANTHROPIC_BASE_URL=
# Model that reads receipts (default claude-haiku-5-5; google/gemma-4-26b-a4b-it with RECEIPTS_PROVIDER=openrouter).
# RECEIPTS_MODEL=claude-haiku-5-5
# Stronger model asked once when the lines don't add up to the total. Empty (default) = no cascade.
# RECEIPTS_FALLBACK_MODEL=
# Timeout of one recognition request, seconds (default 30).
# RECEIPTS_TIMEOUT_SEC=30
# Closed beta (default 1): receipt scanning works only for groups the owner approved (button in the bot, /beta <code>).
# Requests go to ADMIN_USER_IDS; /requests lists pending ones. 0 = open to everyone (trial limit still applies).
# RECEIPTS_BETA=1
# Free scans per group per calendar month, until the group gets the `receipts` right (default 5).
# RECEIPTS_GROUP_TRIAL_MONTHLY=5
# Receipt requests per user per minute (default 3).
# RECEIPTS_USER_PER_MIN=3
# Global spend ceiling per month, USD. At 80% the owner (ADMIN_USER_IDS) gets a message, at 100% scanning pauses.
# RECEIPTS_GLOBAL_MONTHLY_USD=10
# Provider prices, USD per 1M tokens (defaults: Haiku 5.5; Gemma 4 26B A4B on OpenRouter is about 0.07 / 0.23). Used for every model, so set them if the cascade is on.
# RECEIPTS_PRICE_IN_USD_PER_M=0.1
# RECEIPTS_PRICE_OUT_USD_PER_M=0.5

# Quotas per account / group (defaults shown). Over the limit the API answers 409.
# MAX_GROUPS_PER_USER=100
# MAX_MEMBERS_PER_GROUP=100
# MAX_EXPENSES_PER_GROUP=10000
# MAX_RECURRING_PER_GROUP=50

# How many of the latest expenses a group carries in GET /api/groups/:id (default 200, max 1000).
# Older ones load page by page via GET /api/groups/:id/expenses?before=<id>.
# EXPENSES_PAGE=200

# Bot limits per user per minute: commands (default 20) and inline queries (default 30).
# BOT_COMMANDS_PER_MIN=20
# BOT_INLINE_PER_MIN=30
